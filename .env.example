# 모든 값은 빌드된 정적 파일(브라우저)에 그대로 노출된다. Secret을 넣지 않는다.

# GA4 측정 ID (예: G-XXXXXXXXXX). 비워두면 Analytics 스크립트를 로드하지 않는다.
NUXT_PUBLIC_GA_ID=

# 운영 도메인 (canonical, og:url, sitemap.xml, robots.txt에 사용). 끝에 / 없이 입력.
NUXT_PUBLIC_SITE_URL=https://www.soluconlab.com

# 상담 신청 Google Form URL. 기본값은 nuxt.config.ts에 설정되어 있으며, 다른 Form을 쓸 때만 주석을 풀어 덮어쓴다.
# (빈 값으로 두면 기본값을 덮어써 Form이 표시되지 않으니 주의)
# NUXT_PUBLIC_INQUIRY_FORM_URL=https://docs.google.com/forms/d/e/.../viewform

# 문의 이메일. 기본값(soluconlab@gmail.com)은 nuxt.config.ts에 설정되어 있으며, 바꿀 때만 주석을 풀어 덮어쓴다.
# NUXT_PUBLIC_CONTACT_EMAIL=

# 문의 전화번호 (비워두면 표시하지 않는다)
NUXT_PUBLIC_CONTACT_PHONE=

# 검색엔진 소유 확인 메타 태그 content 값 (비워두면 출력하지 않는다)
# Google Search Console → 속성 추가 → URL 접두어 → HTML 태그 방식
NUXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# 네이버 서치어드바이저 → 사이트 등록 → HTML 태그 방식
NUXT_PUBLIC_NAVER_SITE_VERIFICATION=
