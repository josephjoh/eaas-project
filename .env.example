# 모든 값은 빌드된 정적 파일(브라우저)에 그대로 노출된다. Secret을 넣지 않는다.

# GA4 측정 ID (예: G-XXXXXXXXXX). 비워두면 Analytics 스크립트를 로드하지 않는다.
NUXT_PUBLIC_GA_ID=

# 운영 도메인 (canonical, og:url, sitemap.xml, robots.txt에 사용). 끝에 / 없이 입력.
NUXT_PUBLIC_SITE_URL=https://www.example.com

# 상담 신청 Google Form 공유 URL (https://docs.google.com/forms/d/e/.../viewform)
NUXT_PUBLIC_INQUIRY_FORM_URL=

# 문의 이메일 / 전화번호 (비워두면 해당 항목을 표시하지 않는다)
NUXT_PUBLIC_CONTACT_EMAIL=
NUXT_PUBLIC_CONTACT_PHONE=
